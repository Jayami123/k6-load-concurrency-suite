# Copy to .env. Never commit .env. Names only; leave a line empty to use the default.

# Folder that holds the product forks (harness folder names: cal, documenso, medusa-dtc-starter, twenty-CRM).
# Default when unset: ../products next to this repo. Relative paths resolve from the repo root.
PRODUCTS_ROOT=

# Medusa backend URL. 127.0.0.1 only, never localhost. Default when unset: http://127.0.0.1:9000
MEDUSA_BASE_URL=

# 1 = backend only (default in scripts/harness.mjs). The storefront is not needed for P6.
MEDUSA_SKIP_STOREFRONT=

# Only needed once tests use the Admin API (not Phase 0). Never commit real values.
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=

# Race framework (Phase 1). Leave empty to use defaults documented in README.
# Override harness/CI MEDUSA_DB_URL when pointing at a non-default Postgres.
P6_MEDUSA_DATABASE_URL=

# Number of race trials per spec run. Default when unset: 5 (CI may raise in a later task).
RACE_TRIALS=

# Max client-side dispatch spread in ms (Node start times, not server receive). Default: 5.
RACE_MAX_SPREAD_MS=

# Cal web URL. 127.0.0.1 only. Default when unset: http://127.0.0.1:3000
CAL_BASE_URL=

# Harness Cal DB URL (also read by P6). P6 default when unset: the fork's local trust-auth DB on 127.0.0.1:5450
CAL_DB_URL=

# Override CAL_DB_URL for the P6 oracle only.
P6_CAL_DATABASE_URL=

# Max wait for a long-running harness up (Cal), in ms. Default 3600000.
HARNESS_UP_TIMEOUT_MS=

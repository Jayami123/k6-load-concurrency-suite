{
  "name": "k6-load-concurrency-suite",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "up:medusa": "node scripts/harness.mjs up medusa",
    "down:medusa": "node scripts/harness.mjs down medusa",
    "smoke:medusa": "k6 run --summary-export results/medusa-health-summary.json k6/smoke/medusa-health.js",
    "up:cal": "node scripts/harness.mjs up cal",
    "down:cal": "node scripts/harness.mjs down cal",
    "smoke:cal": "k6 run --summary-export results/cal-health-summary.json k6/smoke/cal-health.js",
    "race:cal": "playwright test --project=cal-race",
    "up:documenso": "node scripts/harness.mjs up documenso",
    "down:documenso": "node scripts/harness.mjs down documenso",
    "smoke:documenso": "k6 run --summary-export results/documenso-health-summary.json k6/smoke/documenso-health.js",
    "race:documenso": "playwright test --project=documenso-race",
    "up:twenty": "node scripts/harness.mjs up twenty",
    "down:twenty": "node scripts/harness.mjs down twenty",
    "seed:twenty": "node scripts/seed-twenty.mjs",
    "race:twenty": "playwright test --project=twenty-race",
    "race:twenty-tw": "playwright test --project=twenty-tw-races",
    "test:twenty-obs": "playwright test --project=twenty-tw-obs",
    "smoke:twenty": "k6 run --summary-export results/twenty-health-summary.json k6/smoke/twenty-health.js",
    "test:documenso-api": "playwright test --project=documenso-api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint:actions": "node scripts/actionlint.mts --install-only",
    "lint:actions": "actionlint",
    "clean:results": "node scripts/clean-results.mjs",
    "test:unit": "node --test tests/unit/*.test.ts",
    "race:medusa": "playwright test --project=medusa-race",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.races.json",
    "k6:inspect": "node scripts/k6-inspect.mjs",
    "load:selftest": "node scripts/load/run-load.ts --case P6-X-LOAD-001",
    "load:validity-selftest": "node scripts/load/run-load.ts --case P6-X-LOAD-004",
    "k6:install": "bash scripts/install-k6.sh",
    "check": "npm run format:check && npm run lint:actions && npm run typecheck && npm run k6:inspect && npm run test:unit"
  },
  "dependencies": {
    "qa-portfolio-harness": "github:Jayami123/qa-portfolio-harness#v0.2.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/k6": "^2",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prettier": "^3.6.2",
    "typescript": "^5"
  }
}
